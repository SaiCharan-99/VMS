# Copy to .env (`cp .env.example .env`) and fill in. Every setting is read by
# vms.config.Settings (prefix VMS_); see backend/vms/config.py for all of them.

# --- Required in production -------------------------------------------------
# "dev" relaxes the secret check and enables `seed-demo`; anything else is production.
VMS_ENV=prod
# >= 32 random chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start outside dev when this is missing, short, or still a placeholder.
VMS_JWT_SECRET=
POSTGRES_PASSWORD=change-me-postgres

# --- Database ---------------------------------------------------------------
# docker-compose.yml builds VMS_DB_URL from these; set VMS_DB_URL yourself without compose.
POSTGRES_USER=vms
POSTGRES_DB=vms
# VMS_DB_URL=postgresql+psycopg://vms:PASSWORD@localhost:5432/vms

# --- Web / API --------------------------------------------------------------
VMS_HTTP_PORT=80
# JSON list. The compose stack serves UI and API from one origin, so none are needed there.
VMS_CORS_ORIGINS=[]
VMS_MAX_UPLOAD_MB=500
VMS_JWT_TTL_HOURS=12
VMS_MEDIA_URL_TTL_S=21600
VMS_LOGIN_MAX_FAILURES=10
VMS_LOGIN_WINDOW_S=900
VMS_LOG_FORMAT=json

# --- Analysis ---------------------------------------------------------------
# Build arg: 1 bakes EasyOCR + YOLO into the image; 0 = small image, detectors off.
WITH_ML=1
VMS_OCR_ENABLED=true
VMS_YOLO_ENABLED=true
# Custom detector: put weights + <name>.model_card.json in the data volume, e.g.
# VMS_YOLO_WEIGHTS=/data/models/vms-det-2026-10-01.pt
VMS_RUBRIC_FORWARD=forward-v1
VMS_RUBRIC_RETURN=return-v1
VMS_JOB_STALE_S=300
VMS_JOB_MAX_ATTEMPTS=3

# --- Retention --------------------------------------------------------------
# Days before `python -m vms.cli purge` deletes a settled video's file (rows and evidence stay).
# Unset = keep forever.
# VMS_RETENTION_DAYS=180
