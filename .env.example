# Copy to .env (gitignored). Every setting is optional; defaults are shown.
# Full list: backend/vms/config.py (Settings, VMS_ prefix).

# Storage and database
VMS_DATA_DIR=data
VMS_DB_URL=sqlite:///data/vms.db
# Postgres (pip install -e "backend[postgres]"):
# VMS_DB_URL=postgresql+psycopg://vms:vms@localhost:5432/vms
VMS_MAX_UPLOAD_MB=500
VMS_CORS_ORIGINS=["http://localhost:5173"]

# Worker / job queue
VMS_WORKER_POLL_S=1.5
VMS_JOB_STALE_S=300
VMS_JOB_MAX_ATTEMPTS=3

# Analysis
VMS_OCR_ENABLED=true
VMS_YOLO_ENABLED=true
VMS_YOLO_WEIGHTS=yolov8n.pt
VMS_PROCESS_FPS=3
VMS_ANALYSIS_WIDTH=640
VMS_BLUR_THRESHOLD=30
VMS_MIN_BRIGHTNESS=40
VMS_MAX_BRIGHTNESS=250
VMS_OCR_EVERY_N=3
VMS_OCR_WIDTH=480
VMS_YOLO_CONF=0.35
# Phase 6: custom model. The model card (<weights>.model_card.json) beside the weights sets the class map.
# VMS_YOLO_WEIGHTS=data/models/vms-det-2026-01-01.pt
# VMS_YOLO_MODEL_CARD=
VMS_YOLO_EVERY_N=1
VMS_TAG_CLOSE_UP_FRAC=0.04
# Active rubric per process type (v2 needs the custom model)
VMS_RUBRIC_FORWARD=forward-v1
VMS_RUBRIC_RETURN=return-v1
VMS_HEURISTIC_PRODUCT_FALLBACK=true

# Auth (required outside dev: VMS_ENV=prod needs VMS_JWT_SECRET)
VMS_ENV=dev
# VMS_JWT_SECRET=<long random string>   # dev auto-generates one per process if unset
VMS_JWT_TTL_HOURS=12
VMS_LOGIN_MAX_FAILURES=10
VMS_LOGIN_WINDOW_S=900
VMS_MEDIA_URL_TTL_S=21600
